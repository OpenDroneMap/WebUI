[Unit]
Description=Start OpenDroneMap WebUI Celery Scheduler Service Container
Requires=webui-gunicorn.service
After=webui-gunicorn.service

[Service]
Type=simple
User=odm
Group=odm
PIDFile=/run/webui-celerybeat.pid
WorkingDirectory=/webui
ExecStart=/webui/python3-venv/bin/celery -A worker beat --pidfile=
ExecStop=/bin/kill -s QUIT $MAINPID
Restart=on-failure

[Install]
WantedBy=multi-user.target
